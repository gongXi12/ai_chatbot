NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# memory 仅用于本地开发；部署时使用 postgres
STORAGE_DRIVER=memory
DATABASE_URL=postgres://companion:companion@127.0.0.1:5432/companion

# 留空时不注册 /admin 路由
ADMIN_TOKEN=
# 生产环境必须至少 32 位；本地留空则不启用 HTTP chat token
CHAT_API_TOKEN=

# true: 跳过成年/称呼授权确认，默认按成年女友模式（仅限个人自用部署）
COMPANION_AUTO_AFFECTION=false

MODEL_PROVIDER=echo
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
SENTRY_DSN=

WEIXIN_ACCOUNT_ID=
WEIXIN_BOT_TOKEN=
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
