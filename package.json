{
    "name":  "wechat-companion-bot",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "A safety-aware, memory-grounded romantic companion chatbot with pluggable chat channels.",
    "engines":  {
                    "node":  "\u003e=22"
                },
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "start":  "tsx src/server.ts",
                    "build":  "tsc -p tsconfig.json \u0026\u0026 node scripts/copyMigrations.mjs",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "lint":  "eslint .",
                    "check":  "npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm test \u0026\u0026 npm run build",
                    "db:up":  "docker compose up -d postgres",
                    "db:down":  "docker compose down",
                    "db:migrate":  "tsx scripts/migrate.ts",
                    "test:postgres":  "vitest run tests/integration/postgres.integration.test.ts",
                    "smoke":  "tsx scripts/smoke.ts",
                    "eval:prompt":  "tsx scripts/evaluatePrompt.ts"
                },
    "dependencies":  {
                         "@sentry/node":  "^10.70.0",
                         "dotenv":  "^17.4.2",
                         "fastify":  "^5.11.3",
                         "pg":  "^8.23.0",
                         "zod":  "^4.4.3"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.0.0",
                            "@types/node":  "^24.0.0",
                            "@types/pg":  "^8.21.0",
                            "eslint":  "^9.0.0",
                            "pg-mem":  "^3.0.14",
                            "tsx":  "^4.0.0",
                            "typescript":  "^5.0.0",
                            "typescript-eslint":  "^8.0.0",
                            "vitest":  "^3.0.0"
                        }
}